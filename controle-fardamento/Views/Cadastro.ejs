<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastrar Item - Almox Center</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-white">
    <nav class="navbar navbar-dark bg-dark border-bottom">
        <div class="container">
            <a class="navbar-brand" href="/dashboard">Almox Center - TG</a>
            <a href="/inventario" class="btn btn-outline-light btn-sm">Voltar ao Inventário</a>
        </div>
    </nav>

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <h2 class="mb-4">➕ Cadastrar Novo Item</h2>

                <form action="/cadastro" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Categoria</label>
                        <select name="categoria" class="form-select" required>
                            <option value="Farda">Farda</option>
                            <option value="TFM">TFM</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tipo / Nome do Item</label>
                        <input type="text" name="tipo" class="form-control" placeholder="Ex: Gandola, Coturno..." required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tamanho</label>
                        <input type="text" name="tamanho" class="form-control" placeholder="Ex: P, M, G, Único, 40..." required>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Quantidade Inicial</label>
                        <input type="number" name="quantidade" class="form-control" value="0" min="0">
                    </div>

                    <button type="submit" class="btn btn-success w-100">Cadastrar Item</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>