<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventário - Controle de Fardamento</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-white">
    <nav class="navbar navbar-dark bg-dark border-bottom">
        <div class="container">
            <a class="navbar-brand" href="/dashboard">Controle de Fardamento - TG</a>
            <a href="/dashboard" class="btn btn-outline-light btn-sm">Voltar</a>
        </div>
    </nav>

    <div class="container mt-5">
        <h2 class="mb-4">📦 Inventário de Fardamento</h2>

        <table class="table table-dark table-striped">
            <thead>
                <tr>
                    <th>Tipo</th>
                    <th>Tamanho</th>
                    <th>Quantidade</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% if (inventario && inventario.length > 0) { %>
                    <% inventario.forEach(item => { %>
                    <tr>
                        <td><%= item.tipo %></td>
                        <td><%= item.tamanho %></td>
                        <td><strong><%= item.quantidade %></strong></td>
                        <td>
                            <form action="/movimentacao" method="POST" class="d-flex gap-2">
                                <input type="hidden" name="itemId" value="<%= item.id %>">
                                <select name="tipo" class="form-select form-select-sm" style="width: 120px;">
                                    <option value="entrada">Entrada</option>
                                    <option value="saida">Saída</option>
                                    <option value="extravio">Extravio</option>
                                </select>
                                <input type="number" name="quantidade" value="1" min="1" class="form-control form-control-sm" style="width: 80px;">
                                <button type="submit" class="btn btn-success btn-sm">Registrar</button>
                            </form>
                        </td>
                    </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="4" class="text-center">Nenhum item cadastrado ainda.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</body>
</html>