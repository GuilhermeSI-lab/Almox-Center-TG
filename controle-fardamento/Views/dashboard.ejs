<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Controle de Fardamento</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #0f172a; color: white; }
        .card { transition: transform 0.2s; }
        .card:hover { transform: translateY(-5px); }
    </style>
</head>
<body>
    <!-- Navbar melhorada -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/dashboard">🎖️ Controle de Fardamento - TG</a>
            
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/inventario">Inventário</a>
                <a class="btn btn-outline-light btn-sm ms-3" href="/logout">Sair</a>
            </div>
        </div>
    </nav>

    <div class="container mt-5">
        <h1 class="mb-2">Bem-vindo ao Sistema!</h1>
        <p class="lead text-light">Projeto Integrador - Tiro de Guerra</p>

        <div class="row mt-5">
            <!-- Card Estoque (funcional) -->
            <div class="col-md-4 mb-4">
                <a href="/inventario" class="text-decoration-none">
                    <div class="card bg-primary text-white h-100">
                        <div class="card-body">
                            <h5 class="card-title">📦 Estoque / Inventário</h5>
                            <p class="card-text">Gerenciar entrada, saída e extravios de fardamento.</p>
                            <span class="btn btn-light btn-sm">Acessar Inventário →</span>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Card Cadastros -->
            <div class="col-md-4 mb-4">
                <div class="card bg-success text-white h-100">
                    <div class="card-body">
                        <h5 class="card-title">👤 Cadastros</h5>
                        <p class="card-text">Em breve: cadastro de novos itens e usuários.</p>
                    </div>
                </div>
            </div>

            <!-- Card Relatórios -->
            <div class="col-md-4 mb-4">
                <div class="card bg-warning text-dark h-100">
                    <div class="card-body">
                        <h5 class="card-title">📊 Relatórios</h5>
                        <p class="card-text">Em breve: relatórios de movimentação e estoque.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>