<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Almox Center</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #0f172a, #1e2937);
            color: white;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-box {
            max-width: 420px;
            width: 100%;
            background: rgba(255, 255, 255, 0.1);
            padding: 40px 35px;
            border-radius: 18px;
            backdrop-filter: blur(14px);
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255,255,255,0.1);
        }
        .logo-tg {
            max-width: 130px;
            margin-bottom: 20px;
            filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3));
        }
        .form-control {
            background-color: rgba(255,255,255,0.95);
            border: none;
        }
        .btn-success {
            background: linear-gradient(90deg, #22c55e, #16a34a);
            border: none;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="login-box mx-auto text-center">
            
            <!-- Logo do TG -->
            <img src="/img/logo-tg.png" alt="Logo TG 02-005" class="logo-tg">

            <h2 class="mb-1 fw-bold">Almox Center</h2>
            <h6 class="mb-4 text-light">Tiro de Guerra 02-005</h6>

            <!-- Mensagens de erro/sucesso -->
            <% if (error_msg) { %>
                <div class="alert alert-danger py-2"><%= error_msg %></div>
            <% } %>
            <% if (success_msg) { %>
                <div class="alert alert-success py-2"><%= success_msg %></div>
            <% } %>

            <!-- Formulário -->
            <form action="/login" method="POST">
    <div class="mb-3 text-start">
        <label class="form-label fw-semibold">Nome</label>
        <input type="text" name="nome" class="form-control form-control-lg" placeholder="Ex: ST Lester" required>
    </div>
    
    <div class="mb-4 text-start">
        <label class="form-label fw-semibold">Senha</label>
        <input type="password" name="password" class="form-control form-control-lg" required>
    </div>

    <button type="submit" class="btn btn-success w-100 py-2 fs-5">Entrar</button>
</form>
        </div>
    </div>
</body>
</html>